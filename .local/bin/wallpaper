#!/bin/sh
# set/next/previous/random wallpaper over hsetroot.
# Usage: wallpaper [set|next|previous|random]   (no arg = dmenu picker)

bgdir="${XDG_DATA_HOME:-$HOME/.local/share}/backgrounds"
statedir="${XDG_STATE_HOME:-$HOME/.local/state}/spacbr"
statefile="$statedir/wallpaper"
mkdir -p "$statedir"

# No success notification anywhere below -- the wallpaper visibly
# changing is its own feedback (same reasoning as power's lock/logout/
# reboot). This is only for the one case where nothing else on screen
# would ever tell you something went wrong: an empty/missing bgdir (a
# real case on a fresh install before backgrounds are deployed, or the
# directory just being emptied) previously made every subcommand
# silently do nothing -- `apply` bailing out on a nonexistent file with
# a bare `return 1` and no other feedback path anywhere in this script.
notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send "Wallpaper" "$1"
}

list() {
    # ! -name '.*' excludes macOS AppleDouble sidecar files (._foo.jpg):
    # found for real after scp'ing backgrounds from a Mac, they matched
    # the extension filter and sorted before the real files, so they
    # were the first candidates offered and would break hsetroot if picked.
    find "$bgdir" -maxdepth 1 -type f ! -name '.*' \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) | sort
}

current() {
    [ -f "$statefile" ] && cat "$statefile"
}

apply() {
    if [ ! -f "$1" ]; then
        notify "No wallpaper found in $bgdir"
        return 1
    fi
    hsetroot -fill "$1"
    printf '%s\n' "$1" > "$statefile"
}

step() {
    files=$(list)
    cur=$(current)
    total=$(printf '%s\n' "$files" | wc -l)
    idx=$(printf '%s\n' "$files" | grep -nFx "$cur" | cut -d: -f1)
    [ -z "$idx" ] && idx=1
    if [ "$1" = "next" ]; then
        idx=$(( idx % total + 1 ))
    else
        idx=$(( (idx - 2 + total) % total + 1 ))
    fi
    apply "$(printf '%s\n' "$files" | sed -n "${idx}p")"
}

case "$1" in
    next)     step next ;;
    previous) step previous ;;
    random)   apply "$(list | shuf -n1)" ;;
    set)      apply "$2" ;;
    "")
        choice=$(list | xargs -n1 basename | dmenu -p "wallpaper")
        [ -n "$choice" ] && apply "$bgdir/$choice"
        ;;
    *)
        echo "Usage: $0 [set FILE|next|previous|random]" >&2
        exit 1
        ;;
esac
