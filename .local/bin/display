#!/bin/sh
# dmenu-driven display management over xrandr.
# Replaces the arandr GUI dependency with the keyboard -> dmenu -> action model.

# No "internal"/"external" (eDP/LVDS) assumption -- this project's own
# reference test machine is a desktop with no laptop panel at all, so
# picking outputs by name pattern silently matched nothing there, and
# every multi-output action below quietly ran against an empty output
# name. Just take the first two CONNECTED outputs in whatever order
# xrandr reports them; that works whether it's a laptop (panel first)
# or a desktop with two monitors.
primary="$(xrandr --query | awk '/ connected/ {print $1; exit}')"
secondary="$(xrandr --query | awk -v skip="$primary" '/ connected/ && $1 != skip {print $1; exit}')"

notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send "Display" "$1"
}

# Only reports success if xrandr actually succeeded -- it rejects a
# bad/empty output name with a nonzero exit and no visible error on a
# graphical session, so notifying unconditionally previously showed a
# false "success" toast while nothing had actually changed.
run() {
    if xrandr "$@"; then
        notify "$choice"
    else
        notify "Failed: $choice"
    fi
}

choice=$(printf '%s\n' \
    "Detect / Auto" \
    "Extend (secondary right of primary)" \
    "Mirror" \
    "Secondary only" \
    "Primary only" \
    | dmenu -p "display")

case "$choice" in
    "Detect / Auto")
        run --auto
        ;;
    "Extend (secondary right of primary)")
        if [ -z "$primary" ] || [ -z "$secondary" ]; then
            notify "Need two connected displays"
            exit 1
        fi
        run --output "$primary" --auto --output "$secondary" --auto --right-of "$primary"
        ;;
    "Mirror")
        if [ -z "$primary" ] || [ -z "$secondary" ]; then
            notify "Need two connected displays"
            exit 1
        fi
        run --output "$primary" --auto --output "$secondary" --auto --same-as "$primary"
        ;;
    "Secondary only")
        [ -z "$secondary" ] && { notify "No secondary display detected"; exit 1; }
        run --output "$secondary" --auto --output "$primary" --off
        ;;
    "Primary only")
        [ -z "$primary" ] && { notify "No display detected"; exit 1; }
        if [ -n "$secondary" ]; then
            run --output "$primary" --auto --output "$secondary" --off
        else
            run --output "$primary" --auto
        fi
        ;;
    *)
        exit 0
        ;;
esac
