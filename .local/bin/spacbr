#!/bin/sh
# SPACBR's management CLI. Once installed, its supporting install/
# scripts and package manifests live under $XDG_DATA_HOME/spacbr
# (deployed there by install/install.sh) so this works from anywhere,
# regardless of where the original clone was.
set -eu

XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
SPACBR_SELF="$XDG_DATA_HOME/spacbr"

usage() {
    cat <<EOF
spacbr — SPACBR management CLI

  spacbr install      run the installer
  spacbr update       re-apply SPACBR from its current source tree
  spacbr repair       diagnose and fix common problems
  spacbr uninstall    remove SPACBR-deployed files (packages/data untouched)
  spacbr doctor       run diagnostics only, no changes
  spacbr info         show system/version summary
  spacbr version      print the installed SPACBR version

  spacbr network      open nmtui (scan/connect/disconnect/saved networks)
  spacbr dns          DNS server picker (DHCP/Cloudflare/Google/Quad9/custom)
  spacbr audio        select output/input device, volume up/down/mute
  spacbr brightness    up/down/set <pct>/get, or a dmenu menu with no args
  spacbr bluetooth     scan/connect/disconnect/trust/remove devices
  spacbr display      xrandr layout menu
  spacbr wallpaper     set/next/previous/random wallpaper
  spacbr screenshot    full/window/region/color screenshot
  spacbr record        full/region/window screen recording, with/without audio
  spacbr mirrors       refresh pacman mirrorlist via reflector
  spacbr power         lock/logout/suspend/reboot/shutdown menu
EOF
}

case "${1:-}" in
    install)    shift; exec "$SPACBR_SELF/install/install.sh" "$@" ;;
    update)     shift; exec "$SPACBR_SELF/install/update.sh" "$@" ;;
    repair)     shift; exec "$SPACBR_SELF/install/repair.sh" "$@" ;;
    uninstall)  shift; exec "$SPACBR_SELF/install/uninstall.sh" "$@" ;;
    doctor)     shift; exec "$SPACBR_SELF/install/doctor.sh" "$@" ;;
    version)    cat "$SPACBR_SELF/VERSION" 2>/dev/null || echo "not installed" ;;
    info)       shift; exec "$SPACBR_SELF/install/info.sh" "$@" ;;
    network)    exec "${TERMINAL:-st}" -e nmtui ;;
    dns)        shift; exec "$HOME/.local/bin/dns" "$@" ;;
    audio)      shift; exec "$HOME/.local/bin/audio" "$@" ;;
    brightness) shift; exec "$HOME/.local/bin/brightness" "${@:-menu}" ;;
    bluetooth)  shift; exec "$HOME/.local/bin/bluetooth" "$@" ;;
    display)    shift; exec "$HOME/.local/bin/display" "$@" ;;
    wallpaper)  shift; exec "$HOME/.local/bin/wallpaper" "$@" ;;
    screenshot) shift; exec "$HOME/.local/bin/screenshot" "$@" ;;
    record)     shift; exec "$HOME/.local/bin/record" "$@" ;;
    mirrors)    shift; exec "$HOME/.local/bin/mirrors" "$@" ;;
    power)      shift; exec "$HOME/.local/bin/power" "$@" ;;
    -h|--help|help|"") usage ;;
    *)
        echo "spacbr: unknown command '$1'" >&2
        usage >&2
        exit 1
        ;;
esac
