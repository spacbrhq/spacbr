#!/bin/sh
case $BLOCK_BUTTON in
    1) "$TERMINAL" -e nmtui; pkill -RTMIN+4 dwmblocks ;;
    6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

cache="/tmp/netstatus_cache_${USER}"
lock="/tmp/netstatus_lock_${USER}.lock"

# Whichever interface actually carries the default route -- ethernet,
# WiFi, or anything else NetworkManager brings up. Matching interface
# names by prefix (previously /^e/ for "ethernet") silently misses
# WiFi interfaces (wlan0, wlp2s0, ...), which never start with e, so
# a WiFi-only machine would show "no eth" forever regardless of
# actual connectivity.
iface="$(ip route show default 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i=="dev") {print $(i+1); exit}}')"

if [ -n "$iface" ]; then
    read -r ifstate < "/sys/class/net/$iface/operstate" 2>/dev/null
    if [ "$ifstate" = 'up' ]; then
        stale=$(( $(date +%s) - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))
        if [ ! -f "$cache" ] || [ "$stale" -ge 30 ]; then
            if mkdir "$lock" 2>/dev/null; then
                (
                    trap 'rm -rf "$lock"' EXIT
                    gw="$(ip route | awk '/default/ { print $3; exit }')"
                    if ping -c1 -W1 -q "$gw" >/dev/null 2>&1; then
                        if ping -c1 -W2 -q 9.9.9.9 >/dev/null 2>&1 \
                        || ping -c1 -W2 -q 1.1.1.1 >/dev/null 2>&1; then
                            echo online > "$cache.tmp"
                        else
                            echo offline > "$cache.tmp"
                        fi
                    else
                        echo offline > "$cache.tmp"
                    fi
                    mv "$cache.tmp" "$cache"
                ) &
            fi
        fi
        read -r netstatus < "$cache" 2>/dev/null
        [ "$netstatus" = 'online' ] && staticon="online" || staticon="offline"
    else
        staticon="disconnected"
    fi
else
    staticon="no network"
fi

printf "%s\n" "$staticon"
