#!/bin/sh
# dmenu-driven front-end over bluetoothctl.

. "$HOME/.local/share/spacbr/notify.sh"
notify() { spacbr_notify "Bluetooth" "$1"; }

# Found for real on BT-less hardware: with no controller, systemd's own
# ConditionPathIsDirectory=/sys/class/bluetooth keeps bluetoothd from ever
# starting, so bluetoothctl has no org.bluez D-Bus service to talk to and
# hangs indefinitely instead of failing -- same check the doctor uses.
if [ ! -d /sys/class/bluetooth ]; then
    notify "No Bluetooth adapter found"
    exit 1
fi

pick_device() {
    list=$(bluetoothctl devices)
    name=$(printf '%s\n' "$list" | sed -E 's/^Device [0-9A-F:]+ //' | dmenu -p "$1")
    [ -z "$name" ] && return 1
    # Exact string comparison (awk's ==), not a regex match against a
    # pattern built from the device's own name -- a real device name
    # containing regex metacharacters (parens, dots, '+', all common:
    # "Bose QC35 (LE)", "JBL Flip 5.1") broke the old `~` match
    # silently, so picking that device from the list resolved to no
    # MAC address at all.
    printf '%s\n' "$list" | awk -v n="$name" '{
        mac = $2
        sub(/^Device [0-9A-F:]+ /, "")
        if ($0 == n) { print mac; exit }
    }'
}

toggle_power() {
    if bluetoothctl show | grep -q "Powered: yes"; then
        bluetoothctl power off && notify "Powered off" || notify "Failed to power off"
    else
        bluetoothctl power on && notify "Powered on" || notify "Failed to power on"
    fi
}

scan_and_pair() {
    notify "Scanning (10s)..."
    bluetoothctl --timeout 10 scan on >/dev/null 2>&1
    mac=$(pick_device "connect")
    [ -z "$mac" ] && exit 0
    bluetoothctl trust "$mac"
    bluetoothctl connect "$mac" && notify "Connected" || notify "Connect failed"
}

choice=$(printf '%s\n' \
    "Toggle power" \
    "Scan & connect new device" \
    "Connect known device" \
    "Disconnect device" \
    "Remove device" \
    | dmenu -p "bluetooth")

case "$choice" in
    "Toggle power")
        toggle_power
        ;;
    "Scan & connect new device")
        scan_and_pair
        ;;
    "Connect known device")
        mac=$(pick_device "connect")
        [ -n "$mac" ] && { bluetoothctl connect "$mac" && notify "Connected" || notify "Connect failed"; }
        ;;
    "Disconnect device")
        mac=$(pick_device "disconnect")
        [ -n "$mac" ] && { bluetoothctl disconnect "$mac" && notify "Disconnected" || notify "Disconnect failed"; }
        ;;
    "Remove device")
        mac=$(pick_device "remove")
        [ -n "$mac" ] && { bluetoothctl remove "$mac" && notify "Removed" || notify "Remove failed"; }
        ;;
    *)
        exit 0
        ;;
esac
