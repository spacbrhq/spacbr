#!/usr/bin/env bash
set -euo pipefail
export DISPLAY="${DISPLAY:-:0}"

# Dependencies check -- notify-send deliberately excluded: it's
# supplementary feedback, not something this script's actual job
# (capturing and saving an image) depends on, and every other SPACBR
# script treats it as optional (`command -v notify-send && notify-send
# ...`) rather than a hard requirement. Requiring it here was the one
# inconsistent exception -- a machine without dunst/notify-send
# installed could still use every other dmenu script, just without
# notifications, but this one would refuse to take a screenshot at all.
for cmd in xclip import; do command -v "$cmd" &>/dev/null || { echo "Missing: $cmd" >&2; exit 1; }; done

OUTDIR="${2:-$HOME/Screenshots}"; mkdir -p "$OUTDIR"
FILE="$OUTDIR/$(date +%Y%m%d_%H%M%S).png"
TMP=$(mktemp --suffix=.png); trap 'rm -f "$TMP"' EXIT

show_help(){ 
    cat <<EOF
Usage: $0 [color|full|window] [output_dir]
Environment options:
  WATERMARK=1
  WATERMARK_TEXT='text'
  WATERMARK_POS=position
  WATERMARK_SIZE=px
  WATERMARK_BG='#rrggbbaa'
EOF
}

post(){ 
    [[ "${WATERMARK:-}" == "1" ]] && { 
        command -v magick &>/dev/null || { echo "Missing: magick" >&2; exit 1; }
        # Watermark subsystem (env overrides supported)
        magick "$FILE" \
            -gravity "${WATERMARK_POS:-southeast}" \
            -pointsize "${WATERMARK_SIZE:-28}" \
            -fill white -undercolor "${WATERMARK_BG:-#00000080}" \
            -annotate +20+20 "${WATERMARK_TEXT:-$(date '+%Y-%m-%d %H:%M')}" \
            "$FILE"
    }
    # Notify unconditionally on the save, which already succeeded by
    # this point -- not gated behind the clipboard copy. Under this
    # script's `set -e`, `xclip ... && notify-send ...` meant a
    # transient xclip failure didn't just skip the notification, it
    # silently aborted the whole script right there, so CLAUDE.md's own
    # "capture -> save -> notification" flow lost its last step for a
    # reason that had nothing to do with whether the screenshot itself
    # worked.
    xclip -selection clipboard -t image/png -i "$FILE" || true
    command -v notify-send &>/dev/null && notify-send -i "$FILE" "Screenshot: $(basename "$FILE")"
}

colorpicker(){
    command -v magick &>/dev/null || { echo "Missing: magick" >&2; exit 1; }
    if command -v slop &>/dev/null; then
        geom="$(slop --tolerance=0)" || exit 1
        import -window root -crop "$geom" "$TMP"
    else
        import "$TMP"
    fi
    hex=$(magick "$TMP" -scale 1x1\! -format "#%[hex:p{0,0}]" info: 2>/dev/null || echo "#??????")
    # || true -- same reasoning as post()'s xclip call: under this
    # script's `set -e`, a bare pipeline as the last statement means a
    # transient xclip failure would abort the script right here,
    # skipping the notification below for a reason unrelated to whether
    # the color was actually picked.
    echo "$hex" | xclip -selection clipboard -i || true
    command -v notify-send &>/dev/null && notify-send -i "$TMP" "Color: $hex"
}

# capture_failed -- same class of bug already found and fixed once in
# record's slop-cancel case: `import ... && post` under `set -e` meant
# a cancelled/failed selection (e.g. Escape during the rubber-band
# region pick) exited the whole script right there with zero feedback
# anywhere. Every capture path now falls back to this on failure
# instead of silently doing nothing.
capture_failed(){
    command -v notify-send &>/dev/null && notify-send "Screenshot cancelled or failed"
    exit 1
}

capture_full(){
    import -window root "$FILE" && post || capture_failed
}

capture_window(){
    command -v xdotool &>/dev/null || { echo "Missing: xdotool" >&2; exit 1; }
    import -window "$(xdotool getwindowfocus -f)" "$FILE" && post || capture_failed
}

capture_selection(){
    import "$FILE" && post || capture_failed
}

main(){ 
    case "${1:-}" in
        -h|--help) show_help ;;
        color*)    colorpicker ;;
        full)      capture_full ;;
        window)    capture_window ;;
        *)         capture_selection ;;
    esac
}

main "$@"
