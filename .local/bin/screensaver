#!/bin/sh
# xss-lock's notifier (see xinitrc): runs once the idle timeout hits,
# killed with SIGHUP if the user becomes active again, or SIGTERM once
# xss-lock actually starts the locker (~/.local/bin/lock). This is the
# "screensaver" stage before the real lock -- a dim warning, not a
# second idle/lock mechanism: xss-lock stays the one authoritative
# idle daemon, this is just what it runs partway through its cycle.
#
# Dims via brightnessctl rather than a flashy visual effect, matching
# the project's restraint on visual effects. Machines with no backlight
# (desktops) have nothing to dim -- fails gracefully, does nothing,
# the lock still happens on schedule regardless of this script.
set -eu

command -v brightnessctl >/dev/null 2>&1 || exit 0

current=$(brightnessctl get 2>/dev/null) || exit 0

restore() {
    brightnessctl set "$current" >/dev/null 2>&1 || true
    exit 0
}
trap restore HUP TERM INT

brightnessctl set 10% >/dev/null 2>&1 || exit 0

# Stay alive until xss-lock signals us (HUP = activity, TERM = locking)
while :; do
    sleep 3600 &
    wait $!
done
