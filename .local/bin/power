#!/bin/sh
# dmenu-driven power menu: lock, logout, suspend, reboot, shutdown.
# Destructive actions require a second confirmation to avoid accidents.
#
# systemctl, not loginctl, for suspend/reboot/poweroff: verified for
# real that loginctl on this system (systemd 261) has no such verbs at
# all -- only session/user/seat management commands. `loginctl reboot`
# failed outright ("Unknown command verb 'reboot'"), meaning these
# three actions had never actually worked. systemctl's own
# reboot/poweroff/suspend are the canonical commands loginctl's old
# convenience wrappers proxied to, and they still work correctly for
# an active local session without needing sudo.

confirm() {
    [ "$(printf 'No\nYes' | dmenu -p "$1?")" = "Yes" ]
}

choice=$(printf '%s\n' "Lock" "Logout" "Suspend" "Reboot" "Shutdown" | dmenu -p "power")

case "$choice" in
    Lock)
        exec slock
        ;;
    Logout)
        confirm "Logout" && pkill -TERM -u "$USER" dwm
        ;;
    Suspend)
        confirm "Suspend" && { slock & systemctl suspend; }
        ;;
    Reboot)
        confirm "Reboot" && systemctl reboot
        ;;
    Shutdown)
        confirm "Shutdown" && systemctl poweroff
        ;;
    *)
        exit 0
        ;;
esac
