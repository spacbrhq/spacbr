#!/usr/bin/env bash

shopt -s nullglob globstar

typeit=0
if [[ $1 == "--type" ]]; then
	typeit=1
	shift
fi

if [[ -z $DISPLAY ]]; then
	echo "Error: No X11 display detected" >&2
	exit 1
fi
dmenu=dmenu
xdotool="xdotool type --clearmodifiers --file -"

prefix=${PASSWORD_STORE_DIR-~/.password-store}
password_files=( "$prefix"/**/*.gpg )
password_files=( "${password_files[@]#"$prefix"/}" )
password_files=( "${password_files[@]%.gpg}" )

password=$(printf '%s\n' "${password_files[@]}" | "$dmenu" "-i" "$@")

[[ -n $password ]] || exit

# pass-otp (packages/desktop) makes OTP entries work below
pass show "$password" | grep "otpauth://" 2>/dev/null && otp=1

if [[ $typeit -eq 0 ]]; then
	[[ $otp -eq 1 ]] && pass otp -c "$password" 2>/dev/null ||
		pass show -c "$password" 2>/dev/null
else
	if [[ $otp -eq 1 ]]; then
		pass otp "$password" | { IFS= read -r pass; printf %s "$pass"; } | $xdotool
	else
		pass show "$password" | { IFS= read -r pass; printf %s "$pass"; } | $xdotool
	fi
fi
