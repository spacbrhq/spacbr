#!/bin/sh
# dmenu-driven screen/audio recording via ffmpeg (x11grab + pulse audio
# -- both already SPACBR dependencies, no new package needed).
#
# One unified menu -- Full screen/Region/Window/Audio only/Pause
# recording/Resume recording/Stop recording all shown together every
# time, not a menu that context-switches to a completely different set
# of options depending on whether something's already running. Real,
# reported point of confusion with the earlier design: "Stop recording"
# only existed in a menu that appeared *after* something was already
# recording, so it was never discoverable by looking at the normal menu
# -- a person could reasonably conclude the option didn't exist at all.
#
# SIGINT, not SIGKILL/SIGTERM: ffmpeg needs to see it to write a valid
# moov atom and finalize the mp4 (or audio container) cleanly. A
# killed-outright recording is usually an unplayable, truncated file.

VIDEODIR="$HOME/Videos"
AUDIODIR="$HOME/Music"
mkdir -p "$VIDEODIR" "$AUDIODIR"
PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/spacbr-record.pid"
LOGFILE="${XDG_RUNTIME_DIR:-/tmp}/spacbr-record.log"
FILEFILE="${XDG_RUNTIME_DIR:-/tmp}/spacbr-record.file"

. "$HOME/.local/share/spacbr/notify.sh"
notify() { spacbr_notify "Record" "$1"; }

is_recording() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

# Paused state is read directly from the OS (ps's own stat field, "T"
# for stopped-by-signal), not tracked in a separate flag file -- a
# second piece of state to keep in sync with reality is exactly the
# kind of thing that drifts and lies. Only meaningful when actually
# recording; a dead/nonexistent PID is never "paused".
is_paused() {
    is_recording || return 1
    case "$(ps -o stat= -p "$(cat "$PIDFILE")" 2>/dev/null)" in
        T*) return 0 ;;
        *) return 1 ;;
    esac
}

stop_recording() {
    pid="$(cat "$PIDFILE")"
    # SIGCONT first, unconditionally, before SIGINT: a stopped
    # (SIGSTOP'd) process doesn't process *any* signal, including the
    # SIGINT below, until it's resumed -- stopping while paused would
    # otherwise leave ffmpeg wedged in T state forever, with the file
    # never finalized, while this script had already deleted PIDFILE
    # and moved on as if it succeeded. Harmless no-op if it wasn't
    # actually paused.
    kill -CONT "$pid" 2>/dev/null
    kill -INT "$pid"
    rm -f "$PIDFILE"
    # Named file, not just the directory -- matching screenshot's own
    # notification, which names the actual file it saved.
    saved="$(cat "$FILEFILE" 2>/dev/null)"
    rm -f "$FILEFILE"
    notify "Recording stopped and saved to ${saved:-$VIDEODIR}"
}

# SIGSTOP/SIGCONT, not a "real" ffmpeg pause feature (it has none for
# x11grab) -- this is the standard, documented trick: a stopped process
# reads no frames and advances no timestamps, so resuming later just
# continues the output with no gap, no frozen frame, and no audio
# backlog to catch up on (PulseAudio drops what it can't buffer while
# nothing's reading). Pauses the whole process, video and audio
# together, atomically.
pause_recording() {
    kill -STOP "$(cat "$PIDFILE")"
    notify "Recording paused"
}

resume_recording() {
    kill -CONT "$(cat "$PIDFILE")"
    notify "Recording resumed"
}

target=$(printf '%s\n' "Full screen" "Region" "Window" "Audio only" "Pause recording" "Resume recording" "Stop recording" | dmenu -p "record")
[ -z "$target" ] && exit 0

case "$target" in
    "Stop recording")
        if is_recording; then
            stop_recording
        else
            notify "Not currently recording"
        fi
        exit 0
        ;;
    "Pause recording")
        if is_paused; then
            notify "Already paused"
        elif is_recording; then
            pause_recording
        else
            notify "Not currently recording"
        fi
        exit 0
        ;;
    "Resume recording")
        if is_paused; then
            resume_recording
        elif is_recording; then
            notify "Not paused"
        else
            notify "Not currently recording"
        fi
        exit 0
        ;;
esac

# Picking a start option while something's already running would
# otherwise spawn a second, overlapping ffmpeg and silently overwrite
# PIDFILE/FILEFILE out from under the first one -- refuse clearly
# instead, matching this project's "no silent failures" convention.
if is_recording; then
    notify "Already recording -- stop it first"
    exit 0
fi

# "No audio" only makes sense when there's a video track to pair it
# with -- recording audio-only with no audio input is nonsensical, so
# that mode gets its own two-choice prompt instead of the three-choice
# one video targets use.
if [ "$target" = "Audio only" ]; then
    audio=$(printf '%s\n' "Microphone" "System audio" | dmenu -p "audio source")
else
    audio=$(printf '%s\n' "No audio" "Microphone" "System audio" | dmenu -p "audio")
fi
[ -z "$audio" ] && exit 0

# xdotool/slop are both in packages/desktop, so this should never
# actually fire on a correctly-provisioned install -- but screenshot
# already checks for the exact same tools before using them the same
# way (window geometry, region pick), and record silently had no such
# check at all: a missing xdotool/slop here fed empty coordinates
# straight into ffmpeg instead of failing with a clear message.
case "$target" in
    "Full screen"|"Window") need=xdotool ;;
    "Region")                need=slop ;;
esac
if [ -n "$need" ]; then
    command -v "$need" >/dev/null 2>&1 || { notify "Missing: $need"; exit 1; }
fi

case "$target" in
    "Full screen")
        # shellcheck disable=SC2046 # word-splitting is the point -- getdisplaygeometry prints "WIDTH HEIGHT", split intentionally into $1/$2
        set -- $(xdotool getdisplaygeometry)
        video_opts="-video_size $1x$2 -i $DISPLAY"
        ;;
    "Region")
        # Check slop's own exit status directly (via the assignment),
        # not `set --`'s -- `set --` on an empty/cancelled slop output
        # still succeeds, so cancelling the region picker (Escape or a
        # right-click) previously fell through into a broken ffmpeg
        # call with $3/$4 unset instead of just backing out.
        coords="$(slop -f "%x %y %w %h" 2>/dev/null)" || exit 1
        # shellcheck disable=SC2086 # word-splitting is the point -- $coords is "x y w h", split intentionally into $1..$4; quoting it would pass it as one argument instead
        set -- $coords
        video_opts="-video_size ${3}x${4} -i ${DISPLAY}+${1},${2}"
        ;;
    "Window")
        win="$(xdotool getactivewindow)"
        eval "$(xdotool getwindowgeometry --shell "$win")"
        video_opts="-video_size ${WIDTH}x${HEIGHT} -i ${DISPLAY}+${X},${Y}"
        ;;
esac

case "$audio" in
    "Microphone")
        audio_opts="-f pulse -i default"
        ;;
    "System audio")
        sink="$(pactl get-default-sink 2>/dev/null)"
        [ -z "$sink" ] && { notify "No default audio sink found"; exit 1; }
        audio_opts="-f pulse -i ${sink}.monitor"
        ;;
    "No audio")
        audio_opts=""
        ;;
esac

if [ "$target" = "Audio only" ]; then
    file="$AUDIODIR/$(date +%Y%m%d_%H%M%S).m4a"
    printf '%s\n' "$file" > "$FILEFILE"
    # shellcheck disable=SC2086
    ffmpeg -y $audio_opts -c:a aac "$file" >"$LOGFILE" 2>&1 &
else
    file="$VIDEODIR/$(date +%Y%m%d_%H%M%S).mp4"
    printf '%s\n' "$file" > "$FILEFILE"
    # shellcheck disable=SC2086
    ffmpeg -y -f x11grab -framerate 30 $video_opts $audio_opts \
        -c:v libx264 -preset ultrafast -pix_fmt yuv420p \
        ${audio_opts:+-c:a aac} "$file" >"$LOGFILE" 2>&1 &
fi
echo $! > "$PIDFILE"
disown

notify "Recording started: $target, $audio — run again to stop"
