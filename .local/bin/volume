#!/bin/sh
# Wraps wpctl volume/mute changes with notification feedback. Shared
# by dwm's hardware volume keys and the audio dmenu menu's Volume up/
# down/mute entries so both give the same feedback instead of
# duplicating this logic -- verified for real that wpctl alone changes
# the level correctly, but with zero feedback (no OSD, no
# notification) it read as "volume keys don't work" even though they
# did.

notify() {
    # x-dunst-stack-tag is dunst's own hint for "replace the previous
    # notification with this tag instead of stacking a new one" --
    # verified for real that the more commonly-copied
    # x-canonical-private-synchronous hint (a notify-osd/Canonical
    # convention) is silently accepted by this dunst (1.13.2) but never
    # actually rendered: dunstctl reported it as "currently displayed"
    # while nothing appeared on screen. Confirmed dunst's own hint
    # renders correctly with the exact same call otherwise unchanged.
    command -v notify-send >/dev/null 2>&1 && \
        notify-send -t 1500 -h string:x-dunst-stack-tag:spacbr-volume "Volume" "$1"
}

# raw_pct: bare number (for `get`/scripting/menu labels). pct: the
# same with a trailing % (for notify text) -- kept separate so `get`
# stays parseable the same way .local/bin/brightness's `get` is,
# without changing the existing notification wording.
raw_pct() {
    wpctl get-volume "$1" | awk '{printf "%d", $2*100}'
}
pct() {
    printf '%s%%' "$(raw_pct "$1")"
}

case "${1:-}" in
    up)
        wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
        wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && notify "Muted" || notify "$(pct @DEFAULT_AUDIO_SINK@)"
        ;;
    down)
        wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
        wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && notify "Muted" || notify "$(pct @DEFAULT_AUDIO_SINK@)"
        ;;
    set)
        case "$2" in
            ''|*[!0-9]*) echo "usage: volume set <0-100>" >&2; exit 1 ;;
            *)
                v="$2"; [ "$v" -gt 100 ] && v=100
                wpctl set-volume @DEFAULT_AUDIO_SINK@ "${v}%"
                wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && notify "Muted" || notify "$(pct @DEFAULT_AUDIO_SINK@)"
                ;;
        esac
        ;;
    mute)
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
        wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && notify "Muted" || notify "Unmuted ($(pct @DEFAULT_AUDIO_SINK@))"
        ;;
    mic-mute)
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
        wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && notify "Microphone muted" || notify "Microphone unmuted"
        ;;
    get)
        raw_pct @DEFAULT_AUDIO_SINK@
        ;;
    *)
        echo "usage: volume up|down|set <0-100>|mute|mic-mute|get" >&2
        exit 1
        ;;
esac
