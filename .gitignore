# OS artifacts
.DS_Store
._*
Thumbs.db

# Editor backups/swap
*.orig
*.swp
*.swo
*~

# Generated/state (not source of truth)
.config/nvim/undo/*
!.config/nvim/undo/.gitkeep
.config/vim/undo/*
!.config/vim/undo/.gitkeep
.cache/
.local/state/

# Secrets — never committed
*.pem
*.key
.env

# Release build output — regenerated by release/build.sh, not source
release/dist/

# Local project instructions — kept locally, not published
CLAUDE.md

# Design/mockup reference material — local inspiration only, not part
# of the actual system
resources-unused/

# Claude Code's own local runtime state, not part of the project
.claude/

# Autogenerated by libfm itself ("don't edit, your changes will be
# overwritten" is libfm's own first line in this file) -- tracking a
# static copy just means it goes stale and regresses whatever libfm
# added on its own. See "Deployment model" in docs/architecture.md.
.config/libfm/libfm.conf
