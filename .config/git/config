# eightharsh's git config
#
# $XDG_CONFIG_HOME/git/config, not ~/.gitconfig -- git has supported
# this location natively since 1.7.12, and every other tool in this
# repo already lives under .config; ~/.gitconfig is only used as a
# fallback when this file doesn't exist, so there's no conflict with
# it staying absent.
#
# core.editor deliberately not set here: git already respects $EDITOR
# (see .config/shell/profile) on its own, so setting it here would
# just be a second place that can drift out of sync with the same
# value.

[user]
    name = eightharsh
    email = interact.harsh@gmail.com

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    autoSetupRemote = true

[color]
    ui = auto
