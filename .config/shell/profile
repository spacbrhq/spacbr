#!/bin/sh

# Prepend, not append: SPACBR's own built binaries (dwm/dmenu/st/
# dwmblocks) must win over any same-named system package on PATH.
# Found for real: clipmenu hard-depends on the official `dmenu`
# package (/usr/bin/dmenu) -- appending here meant that generic
# community dmenu silently shadowed SPACBR's own patched/palette-
# colored build at ~/.local/bin/dmenu every time, since /usr/bin
# always came first in PATH.
export PATH="${$(find ~/.local/bin -type d -printf %p:)%%:}:$PATH"
unsetopt PROMPT_SP

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_RUNTIME_DIR=/run/user/$UID

export TERM="st"
export TERMINAL="st"
export EDITOR="vim"
export BROWSER="chromium --force-dark-mode"

export XDG_RUNTIME_DIR=/run/user/$(id -u)
export XINITRC="$XDG_CONFIG_HOME"/xinitrc
export XAUTHORITY="$XDG_RUNTIME_DIR"/Xauthority
export GNUPGHOME="$XDG_DATA_HOME"/gnupg
export GOPATH="$XDG_DATA_HOME"/go
export GOMODCACHE="$XDG_CACHE_HOME"/go/mod
export PASSWORD_STORE_DIR="$XDG_DATA_HOME"/pass
export GTK2_RC_FILES="$XDG_CONFIG_HOME"/gtk-2.0/gtkrc

tabs -4
