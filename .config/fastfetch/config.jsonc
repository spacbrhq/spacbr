// SPACBR fastfetch config -- denshichrome palette, shown on new terminals
// (see .zshrc). Logo colors use fastfetch's truecolor sequence format
// (38;2;R;G;B), not #RRGGBB -- confirmed against the fastfetch wiki.
//
// display.color.keys does the same for the OS/Kernel/Uptime/etc.
// labels -- without it they render in fastfetch's default bright cyan,
// which clashes with the accent blue everywhere else (logo, dwm,
// dmenu, st). separator uses the muted border color (#404552) instead
// of a bright one, so it recedes behind the actual values.
//
// Grouped into three blocks (identity/environment, hardware, network+
// audio) separated by blank lines instead of one long undifferentiated
// list -- more information without it reading as more cluttered.
// Media/Player modules deliberately left out: verified for real (no
// org.mpris.* name on the session bus at all) that mpd doesn't expose
// MPRIS, which is what these modules read from -- they'd never show
// anything with this setup, so including them would be a module that
// silently never works, not a real feature.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch",
        "color": {
            "1": "38;2;64;132;214",
            "2": "38;2;225;227;231"
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;64;132;214",
            "separator": "38;2;64;69;82"
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[38;2;64;132;214mSPACBR\u001b[0m"
        },
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "break",
        "disk",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "break",
        "localip",
        "sound",
        "break",
        "colors"
    ]
}
