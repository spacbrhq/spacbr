#!/bin/sh
userresources=$HOME/.config/xresources
usermodmap=$HOME/.config/xmodmap
sysresources=/etc/X11/xinit/.Xresources
sysmodmap=/etc/X11/xinit/.Xmodmap

# merge in defaults and keymaps
[ -f $sysresources ] && xrdb -merge $sysresources
[ -f $sysmodmap ] && xmodmap $sysmodmap
[ -f "$userresources" ] && xrdb -merge "$userresources"
[ -f "$usermodmap" ] && xmodmap "$usermodmap"

# Automatically set dpi
xrandr --auto
xrandr --dpi 96

# Other things
export SSH_AUTH_SOCK
export XDG_SESSION_TYPE=X11
export GDK_BACKEND=x11
export GTK_THEME="Arc-Dark"
export QT_QPA_PLATFORMTHEME=gtk
# Fix misbehaving Java apps
export _JAVA_AWT_WM_NONREPARENTING=1

# Import DISPLAY/XAUTHORITY into systemd's user manager and D-Bus's
# activation environment. Without this, any D-Bus-activated service
# (dunst, in particular -- it ships a static systemd user unit that
# only starts on first notification, not at session start) fails
# outright: verified for real, "Cannot open X11 display" /
# "Couldn't initialize X11 output. Aborting" on every start attempt,
# because a bare `startx` session (no display-manager/systemd-logind
# graphical-session registration) never gives systemd --user or dbus
# these two variables any other way. A display-manager-based login
# normally handles this via PAM; this is the equivalent for startx.
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY

# Start programs
dwmblocks &
pipewire &
pipewire-pulse &
wireplumber &
picom --config ~/.config/picom/picom.conf &
clipmenud &

# Polkit authentication agent — without one, GUI privilege prompts
# from NetworkManager/udisks2 (pcmanfm's automount) never appear.
# polkit-gnome is "legacy" upstream but still the standard choice for
# minimal WMs; only start it if it's actually installed.
[ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ] && \
	/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &

# Wallpaper: restore last-set (via ~/.local/bin/wallpaper), fall back to a default
statedir="${XDG_STATE_HOME:-$HOME/.local/state}/spacbr"
hsetroot -fill "$(cat "$statedir/wallpaper" 2>/dev/null || echo "$HOME/.local/share/backgrounds/the-backwater.jpg")" &

# Idle locking: blank after 15 min, lock the moment the screen blanks or the
# session suspends. xss-lock is the one lightweight idle mechanism (event
# driven, no polling daemon) and also catches logind-triggered suspend
# (e.g. lid close), not just the power menu's explicit lock-before-suspend.
xset s 900 900
xss-lock -- slock &

exec dbus-launch dwm
