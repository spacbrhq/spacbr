#!/bin/sh
userresources=$HOME/.config/xresources
usermodmap=$HOME/.config/xmodmap
sysresources=/etc/X11/xinit/.Xresources
sysmodmap=/etc/X11/xinit/.Xmodmap

# merge in defaults and keymaps
[ -f $sysresources ] && xrdb -merge $sysresources
[ -f $sysmodmap ] && xmodmap $sysmodmap
[ -f "$userresources" ] && xrdb -merge "$userresources"
[ -f "$usermodmap" ] && xmodmap "$usermodmap"

# Automatically set dpi
xrandr --auto
xrandr --dpi 96

# Keyboard repeat: X11's own default (660ms delay, 25/sec) is
# noticeably sluggish for normal typing/navigation -- this is the
# standard, broadly-agreed-on fix, not a guess at personal preference
# the way mouse acceleration/speed would be (no touchpad on this
# machine -- checked via `xinput list`, a desktop with a USB mouse and
# a gaming keyboard only, so no touchpad tuning applies here).
xset r rate 250 35

# Other things
export SSH_AUTH_SOCK
export XDG_SESSION_TYPE=X11
export GDK_BACKEND=x11
export GTK_THEME="Arc-Dark"
export QT_QPA_PLATFORMTHEME=gtk
# Fix misbehaving Java apps
export _JAVA_AWT_WM_NONREPARENTING=1

# Import DISPLAY/XAUTHORITY into systemd's user manager and D-Bus's
# activation environment. Without this, any D-Bus-activated service
# (dunst, in particular -- it ships a static systemd user unit that
# only starts on first notification, not at session start) fails
# outright: verified for real, "Cannot open X11 display" /
# "Couldn't initialize X11 output. Aborting" on every start attempt,
# because a bare `startx` session (no display-manager/systemd-logind
# graphical-session registration) never gives systemd --user or dbus
# these two variables any other way. A display-manager-based login
# normally handles this via PAM; this is the equivalent for startx.
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY

# Start programs
dwmblocks &
picom --config ~/.config/picom/picom.conf &
clipmenud &

# PipeWire/PulseAudio-compat/WirePlumber are deliberately NOT started
# here. Verified for real this was an actual bug, not just redundant:
# their packages already ship socket-activated systemd --user units
# (enabled by default), and systemd's own per-user instance starts at
# login -- before xinitrc ever runs -- so pipewire.socket is already
# listening on /run/user/$UID/pipewire-0 by the time this file
# executes. Starting `pipewire &` here a second time as a raw process
# tries to bind that same socket path again, which fails; that failure
# cascades (pipewire.socket -> failed, pipewire.service -> dependency
# failed, pipewire-pulse.socket/.service -> dependency failed too) and
# systemd rate-limits further retries (start-limit-hit). Net effect:
# the native PipeWire protocol still mostly worked (wpctl, the raw
# xinitrc-started pipewire process, until it's killed/restarted) but
# the PulseAudio-compat layer (pactl, and anything using it -- ffmpeg's
# `-f pulse` input for the record script's audio option, notably)
# silently never came up at all. Removing these lines lets systemd's
# own already-enabled units do this correctly instead of fighting them.

# Polkit authentication agent — without one, GUI privilege prompts
# from NetworkManager/udisks2 (pcmanfm's automount) never appear.
# polkit-gnome is "legacy" upstream but still the standard choice for
# minimal WMs; only start it if it's actually installed.
[ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ] && \
	/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &

# Wallpaper: restore last-set (via ~/.local/bin/wallpaper), fall back to a default
statedir="${XDG_STATE_HOME:-$HOME/.local/state}/spacbr"
hsetroot -fill "$(cat "$statedir/wallpaper" 2>/dev/null || echo "$HOME/.local/share/backgrounds/the-backwater.jpg")" &

# Idle locking: blank after 15 min, lock the moment the screen blanks or the
# session suspends. xss-lock is the one lightweight idle mechanism (event
# driven, no polling daemon) and also catches logind-triggered suspend
# (e.g. lid close), not just the power menu's explicit lock-before-suspend.
xset s 900 900
# DPMS (actual monitor power-down, separate from X's own screen-blank
# above) was left at whatever the Xorg/driver default happens to be --
# verified for real on this machine that default was 30/30/30 seconds,
# not off. That meant the monitor itself went fully dark within ~30s of
# inactivity while the screensaver/lock above still waited the full 15
# minutes -- a real, unintended mismatch against the documented 15-
# minute idle-lock policy, not a security issue (it still locks
# eventually) but a confusing "why does my screen keep going black"
# experience. Aligned to the same 900s across all three DPMS states.
xset +dpms
xset dpms 900 900 900
xss-lock -- slock &

exec dbus-launch dwm
