#!/bin/sh
# dwm/dmenu/st/dwmblocks/slock all live in ~/.local/bin -- this needs
# to be on PATH before anything below tries to run one of them, or
# `dwm` at the bottom of this file can't be found, exits almost
# instantly, and xinit tears the whole session back down.
# `.zshrc` execs startx from an interactive login shell that already
# sourced `.config/shell/profile` (same PATH prepend, so this is
# usually a no-op by the time it runs) -- kept here anyway as this
# script's own defensive default, since it needs to be correct
# regardless of how it gets invoked, not just from `.zshrc`'s own tty1
# autologin path (a plain manual `startx ~/.config/xinitrc` from some
# other context shouldn't silently depend on a specific caller having
# already set this up). Found for real once already, under the
# previous login-manager-based design: a login tool whose own PATH
# setting unconditionally overwrote the session PATH instead of
# prepending to it, dropping ~/.local/bin entirely, was the actual
# root cause of a real "picks a session, brief flash, back at the
# login screen" bug -- see CHANGELOG.md. That specific tool is gone
# now, but the lesson (this script shouldn't trust its caller's PATH)
# still applies to whatever invokes it next.
PATH="$HOME/.local/bin:$PATH"
export PATH

userresources=$HOME/.config/xresources
usermodmap=$HOME/.config/xmodmap
sysresources=/etc/X11/xinit/.Xresources
sysmodmap=/etc/X11/xinit/.Xmodmap

# merge in defaults and keymaps
[ -f $sysresources ] && xrdb -merge $sysresources
[ -f $sysmodmap ] && xmodmap $sysmodmap
[ -f "$userresources" ] && xrdb -merge "$userresources"
[ -f "$usermodmap" ] && xmodmap "$usermodmap"

# Automatically set dpi
xrandr --auto
xrandr --dpi 96

# Wallpaper: restore last-set (via ~/.local/bin/wallpaper), fall back
# to the same photo Limine and Plymouth already showed during boot
# (system/limine/wallpaper.jpg == .local/share/backgrounds/waves.jpg,
# same file) -- the whole point of sharing one wallpaper across the
# boot chain falls apart at the exact moment that matters most (first
# thing you see once you're actually logged in) if the desktop then
# switches to a completely unrelated image. Placed here (before
# dwmblocks/picom start) and *not* backgrounded with `&`, unlike
# everything below it -- hsetroot painting the root window after dwm's
# own bar/borders already rendered means a visible flash of X's
# default black background first; blocking here means the photo is
# already there by the time anything else draws on top of it.
statedir="${XDG_STATE_HOME:-$HOME/.local/state}/spacbr"
hsetroot -fill "$(cat "$statedir/wallpaper" 2>/dev/null || echo "$HOME/.local/share/backgrounds/waves.jpg")"

# Keyboard repeat: X11's own default (660ms delay, 25/sec) is
# noticeably sluggish for normal typing/navigation -- this is the
# standard, broadly-agreed-on fix, not a guess at personal preference
# the way mouse acceleration/speed would be (no touchpad on this
# machine -- checked via `xinput list`, a desktop with a USB mouse and
# a gaming keyboard only, so no touchpad tuning applies here).
xset r rate 250 35

# Other things
export SSH_AUTH_SOCK
export XDG_SESSION_TYPE=X11
export GDK_BACKEND=x11
export GTK_THEME="Arc-Dark"
export QT_QPA_PLATFORMTHEME=gtk
# Fix misbehaving Java apps
export _JAVA_AWT_WM_NONREPARENTING=1

# Import DISPLAY/XAUTHORITY into systemd's user manager and D-Bus's
# activation environment. Without this, any D-Bus-activated service
# (dunst, in particular -- it ships a static systemd user unit that
# only starts on first notification, not at session start) fails
# outright: verified for real, "Cannot open X11 display" /
# "Couldn't initialize X11 output. Aborting" on every start attempt,
# because a bare `startx` session (no display-manager/systemd-logind
# graphical-session registration) never gives systemd --user or dbus
# these two variables any other way. A display-manager-based login
# normally handles this via PAM; this is the equivalent for startx.
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY

# Start programs
dwmblocks &
picom --config ~/.config/picom/picom.conf &
clipmenud &

# PipeWire/PulseAudio-compat/WirePlumber are deliberately NOT started
# here. Verified for real this was an actual bug, not just redundant:
# their packages already ship socket-activated systemd --user units
# (enabled by default), and systemd's own per-user instance starts at
# login -- before xinitrc ever runs -- so pipewire.socket is already
# listening on /run/user/$UID/pipewire-0 by the time this file
# executes. Starting `pipewire &` here a second time as a raw process
# tries to bind that same socket path again, which fails; that failure
# cascades (pipewire.socket -> failed, pipewire.service -> dependency
# failed, pipewire-pulse.socket/.service -> dependency failed too) and
# systemd rate-limits further retries (start-limit-hit). Net effect:
# the native PipeWire protocol still mostly worked (wpctl, the raw
# xinitrc-started pipewire process, until it's killed/restarted) but
# the PulseAudio-compat layer (pactl, and anything using it -- ffmpeg's
# `-f pulse` input for the record script's audio option, notably)
# silently never came up at all. Removing these lines lets systemd's
# own already-enabled units do this correctly instead of fighting them.

# Polkit authentication agent — without one, GUI privilege prompts
# from NetworkManager/udisks2 (pcmanfm's automount) never appear.
# polkit-gnome is "legacy" upstream but still the standard choice for
# minimal WMs; only start it if it's actually installed.
[ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ] && \
	/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &

# Idle locking: blank after 15 min, lock the moment the screen blanks or the
# session suspends. xss-lock is the one lightweight idle mechanism (event
# driven, no polling daemon) and also catches logind-triggered suspend
# (e.g. lid close), not just the power menu's explicit lock-before-suspend.
xset s 900 900
# DPMS (actual monitor power-down, separate from X's own screen-blank
# above) was left at whatever the Xorg/driver default happens to be --
# verified for real on this machine that default was 30/30/30 seconds,
# not off. That meant the monitor itself went fully dark within ~30s of
# inactivity while the screensaver/lock above still waited the full 15
# minutes -- a real, unintended mismatch against the documented 15-
# minute idle-lock policy, not a security issue (it still locks
# eventually) but a confusing "why does my screen keep going black"
# experience. Aligned to the same 900s across all three DPMS states.
xset +dpms
xset dpms 900 900 900
xss-lock -- slock &

# One-time welcome -- marker written by install.sh only on a genuinely
# fresh install (see there for why), consumed here rather than there
# because nothing exists to receive a notification until dunst (D-Bus-
# activated by the notify-send call itself -- see the
# dbus-update-activation-environment comment above) is actually
# reachable. dwm's whole interaction model ("keyboard shortcut ->
# dmenu -> action") has no on-screen hint anywhere else, so this is the
# one deliberate exception to "no permanent widgets, no branding for
# its own sake" (docs/architecture.md) -- it fires once, ever, per
# install, not on every login.
if [ -f "$statedir/welcome-pending" ]; then
	rm -f "$statedir/welcome-pending"
	command -v notify-send >/dev/null 2>&1 && \
		notify-send -t 8000 -h string:x-dunst-stack-tag:spacbr-welcome \
			"SPACBR" "MODKEY+p opens the launcher, MODKEY+t opens a terminal." &
fi

# Not exec'd (unlike every other line here) specifically so this
# script keeps running as dwm's parent, and this trap actually gets a
# chance to fire once dwm exits, for any reason -- normal logout, a
# crash, or X itself dying out from under it.
#
# Found for real, not theoretical: dwmblocks/picom/clipmenud/etc. above
# are backgrounded with a bare `&`, and nothing was ever killing them
# when the session ended. picom specifically doesn't exit cleanly when
# its X connection dies -- confirmed live, orphaned (reparented to PID
# 1) and pegged at 100% CPU indefinitely after a session ended, dwm
# itself already gone. Whatever picom's own bug is here, this script
# shouldn't rely on every backgrounded helper handling a dead X
# connection gracefully to avoid leaking a runaway process.
trap 'kill $(jobs -p) 2>/dev/null' EXIT
# NOT `dbus-launch dwm` -- confirmed live this was a real, serious bug,
# not a leftover no-op: dbus-launch always spawns its *own* private bus
# and points DBUS_SESSION_BUS_ADDRESS at it for dwm's entire process
# tree, regardless of the correct systemd session bus already available
# (this session logs in through a real systemd/pam_systemd user session
# -- `loginctl` confirms it -- which already sets DBUS_SESSION_BUS_ADDRESS
# to the genuine bus at /run/user/$UID/bus, the exact one D-Bus-activated
# dunst is reachable on). Checked dwm's actual running environment
# against dunst's: dwm was on /tmp/dbus-XXXXXX, dunst was on
# /run/user/1000/bus -- two different buses entirely. Every notify-send
# call made by anything dwm spawns (every dmenu script, every
# keybinding) was silently addressed to a bus dunst was never listening
# on. This went undetected all session because testing notify-send over
# SSH doesn't inherit dwm's environment at all, and falls back to the
# correct bus by auto-discovery instead -- a real-keybinding-triggered
# notification and an SSH-triggered one were never actually taking the
# same path.
dwm
