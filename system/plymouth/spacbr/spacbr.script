# SPACBR boot splash -- eightchrome (by eightharsh). Keep the RGB
# triples in sync with .config/xresources by hand; Plymouth's script
# language has no way to read Xresources.
#
# Shares the same photo as Limine (system/limine/wallpaper.jpg), copied
# here too since Plymouth's Image() loads relative to this theme's own
# ImageDir, not an arbitrary path -- but as wallpaper.png, not the same
# file: Plymouth's own Image() loader is PNG-only (confirmed against
# its actual source, see the note above the Image() call below), so
# this copy is re-exported as PNG and downscaled to 1920px wide (the
# real screen this was tested on is 1600x900 -- Limine's own copy stays
# at Limine's larger, JPEG size for a different reason, UEFI-side
# decode margin, not initramfs size). Same baked-in eightchrome header
# panel either way (see docs/architecture.md's Limine section for how/
# why that panel was made), so the two screens still read as one
# continuous experience instead of Limine showing the photo and
# Plymouth cutting to a flat color. Text below is kept inside roughly
# the top half of the screen on purpose -- that's where the baked
# panel actually darkens the photo enough to stay legible; anything
# placed lower would sit on the same bright/variable wave texture that
# made a plain flat background necessary the first time this theme was
# built without a photo.
#
# Two fonts, deliberately: Rajdhani Bold for the wordmark only (a
# one-off exception to "one house monospace face (Hack) everywhere" --
# see docs/architecture.md "Typography" for why, same kind of
# documented exception Zed already is), Hack Bold for everything else
# (progress rule, password prompt) -- the technical/utility role, same
# face as every other themed surface. Rajdhani has no box-drawing/
# block glyphs at all -- checked against the actual font file -- so it
# was never an option for those.
#
# Verified against Plymouth's own script-plugin source (src/plugins/
# splash/script/script-lib-{sprite,image,plymouth,math}.c and
# script-object.c), not guessed: Window.SetBackgroundTopColor/
# BottomColor(r,g,b) and Image.Text(text,r,g,b,alpha,font) take 0.0-1.0
# floats and a Pango font-description string; Sprite()/SetImage let one
# sprite's image be swapped in place instead of piling up a new sprite
# every progress tick; Math.Int is floor(); the '+' operator
# concatenates when either side is a string (script_obj_plus), which
# is also how a number becomes the trailing size in a font string;
# Plymouth.SetDisplayPasswordFunction's callback gets (prompt, bullets)
# -- prompt a string, bullets an integer count of characters typed so
# far -- confirmed against script_lib_plymouth_on_display_password's
# actual call site, not assumed from the function name alone. The
# background-image scale-to-cover math below (compare screen and image
# aspect ratios, scale by whichever dimension is the tighter fit, then
# center) is Plymouth's own official example pattern for exactly this
# (basic theme reference script), not invented here.

# fallback matte, in case Image() below ever fails to load -- eightchrome bg
Window.SetBackgroundTopColor(0.184, 0.204, 0.247);
Window.SetBackgroundBottomColor(0.184, 0.204, 0.247);

# background photo, scaled to cover the whole screen (may crop one
# axis symmetrically if the screen's aspect ratio doesn't match the
# photo's own ~1.79:1 -- same tolerance already accepted on the Limine
# side, where "stretched" scaling has the equivalent caveat).
#
# .png, not .jpg -- confirmed for real, the actual root cause of the
# wallpaper never once showing since this theme was first built:
# Plymouth's own Image() loader (src/libply-splash-graphics/ply-image.c)
# is PNG-only, built directly against libpng, with no JPEG support
# anywhere in Plymouth's source tree at all. Image("wallpaper.jpg") was
# silently failing every single boot; everything else on screen (text,
# the bar, the password prompt) is built from Image.Text, which doesn't
# depend on this file loading at all, so nothing else hinted anything
# was wrong. This was never actually caught until someone
# looked at the real screen for the first time -- every earlier
# "verified" pass only checked the file's presence/checksum inside the
# built UKI, never whether Plymouth could actually decode it. Limine's
# own copy (system/limine/wallpaper.jpg) stays JPEG -- confirmed
# working there already, a different loader, a different constraint
# (UEFI-side decode speed, not initramfs size).
background_image = Image("wallpaper.png");
screen_ratio = Window.GetHeight() / Window.GetWidth();
background_image_ratio = background_image.GetHeight() / background_image.GetWidth();
if (screen_ratio > background_image_ratio)
  {
    background_scale = Window.GetHeight() / background_image.GetHeight();
  }
else
  {
    background_scale = Window.GetWidth() / background_image.GetWidth();
  }
scaled_background_image = background_image.Scale(background_image.GetWidth() * background_scale, background_image.GetHeight() * background_scale);
background_sprite = Sprite(scaled_background_image);
background_sprite.SetX(Window.GetWidth() / 2 - scaled_background_image.GetWidth() / 2);
background_sprite.SetY(Window.GetHeight() / 2 - scaled_background_image.GetHeight() / 2);
background_sprite.SetZ(-10000);

title_size = Math.Int(Window.GetHeight() * 0.12);
bar_label_size = Math.Int(Window.GetHeight() * 0.016);
prompt_size = Math.Int(Window.GetHeight() * 0.022);
bar_height = Math.Int(Window.GetHeight() * 0.012);
bar_width = Window.GetWidth() * 0.30;

# wordmark: foreground #e1e3e7 (not accent -- the accent is spent on
# the progress rule below, not repeated on the identity too), Rajdhani
# Bold, centered, sized off the screen, sitting inside the baked panel.
wordmark_image = Image.Text("SPACBR", 0.882, 0.890, 0.906, 1, "Rajdhani Bold " + title_size);
wordmark_sprite = Sprite(wordmark_image);
wordmark_sprite.SetX(Window.GetWidth() / 2 - wordmark_image.GetWidth() / 2);
wordmark_sprite.SetY(Window.GetHeight() * 0.22 - wordmark_image.GetHeight() / 2);
wordmark_sprite.SetZ(1);
wordmark_sprite.SetOpacity(0);

# progress rule: a real continuous bar, not a row of repeated block
# glyphs like this used to be. A row of characters (however wide the
# glyph) always has real inter-character tracking/kerning gaps between
# cells, and could only ever step forward in whole-cell increments
# (1/40ths) instead of moving continuously with actual boot progress
# -- both together read as a strip of separate ticks/segments, not one
# bar, which is the exact complaint this replaces.
#
# Built the same way script themes have always had to fake a solid
# rectangle (there is no native "draw rect" primitive here): render one
# glyph once per color via Image.Text, then Image.Scale it to whatever
# pixel size is needed. That is the same primitive an earlier password-
# field attempt used and dropped -- but the two are not the same case.
# That attempt needed a *hollow bordered* box and stretched a tiny
# source by ~15-20x in *both* directions at once, which is what turned
# the AA edge of the source glyph into a visible glow across the whole
# shape. A progress-bar fill is a *solid* rectangle -- exactly what a
# stretched flat glyph already looks like -- and the source glyph here
# is rendered at bar_height itself, so the only real stretch is
# horizontal (from one character's width up to bar_width); the vertical
# scale factor stays ~1:1, which is what actually keeps the earlier
# glow artifact from reappearing.
#
# Track and fill are two separately-colored swatches (foreground at low
# opacity, accent at full), each rendered once and reused via .Scale()
# every tick instead of re-running Image.Text on every frame.
#
# The bar and its percentage readout are centered as ONE fixed group,
# computed once here -- not recentered every tick against just the bar
# (which is what this used to do). Found for real that doing it the
# naive way put the readout hard against the bar's right edge and
# skewed the whole pair off from the wordmark/field above and below
# it -- looked like an afterthought bolted onto the corner of the
# window, not one composed layout. Reserving "100%"'s own width up
# front (percent_reserve_image, discarded immediately after) means
# neither the bar nor the readout shifts sideways as the percentage
# grows from one digit to three -- same "nothing should visibly jump
# around" principle the password field below applies too.
track_swatch = Image.Text("█", 0.882, 0.890, 0.906, 0.16, "Hack Bold " + bar_height);
fill_swatch = Image.Text("█", 0.251, 0.518, 0.839, 1, "Hack Bold " + bar_height);
percent_reserve_image = Image.Text("100%", 0.882, 0.890, 0.906, 1, "Hack Bold " + bar_label_size);
progress_gap = Window.GetWidth() * 0.014;
progress_group_width = bar_width + progress_gap + percent_reserve_image.GetWidth();
track_x = Window.GetWidth() / 2 - progress_group_width / 2;
track_y = wordmark_sprite.GetY() + wordmark_image.GetHeight() + Window.GetHeight() * 0.055;
percent_x = track_x + bar_width + progress_gap;
track_image = track_swatch.Scale(bar_width, bar_height);
track_sprite = Sprite(track_image);
track_sprite.SetX(track_x);
track_sprite.SetY(track_y);
track_sprite.SetZ(0);
track_sprite.SetOpacity(0);

# fill: one sprite, reused every tick via SetImage instead of a new
# Sprite() per tick (which would just pile up unused sprites).
fill_sprite = Sprite();
fill_sprite.SetX(track_x);
fill_sprite.SetY(track_y);
fill_sprite.SetZ(2);

# percentage readout -- own sprite, reused the same way fill_sprite is.
# X is fixed (percent_x, above); Y is set once the real image exists
# (see spacbr_boot_progress_callback), vertically matched to the bar.
percent_sprite = Sprite();
percent_sprite.SetX(percent_x);
percent_sprite.SetZ(2);
percent_sprite.SetOpacity(0);

# Password area: no drawn rule/box at all -- tried both (a bordered
# box, then an underline rule) and dropped both after actually seeing
# them on screen. The box rendered as one flat glowing block instead of
# a bordered field; the underline read as a *second progress bar* right
# next to the real one, since it reused the same block/line-glyph
# language at a similar size and position -- confusing, not polished,
# confirmed directly from real photos of the physical screen, not a
# guess either time. Just the label and the stars, correctly aligned,
# is the actual fix: real misalignment, also confirmed from the same
# photos -- the label was centered against the whole window while the
# stars were left-aligned from a different fixed point, so the two
# lines never lined up on the same edge. Both now share one fixed
# anchor (input_x/input_y) instead.
input_width = Window.GetWidth() * 0.34;
input_x = Window.GetWidth() / 2 - input_width / 2;
input_y = Window.GetHeight() * 0.44;

# password prompt: hidden (opacity 0) until Plymouth actually asks for
# one (LUKS, a TPM passphrase, anything using systemd-ask-password) --
# most SPACBR installs never trigger this, but the theme should not
# fall back to something broken/unstyled on the installs that do.
#
# ONE sprite for both lines, not two -- the real, dynamic fix for the
# alignment problem that survived two earlier attempts (a shared
# input_x, then matching the two images' font sizes). Confirmed from
# Plymouth's own source (script-lib-image.c's Image.Text, backed by
# ply-label.c -> a real Pango layout, pango_layout_set_text) that two
# *separate* Image.Text calls each get their own image individually
# measured and cropped to that call's own content -- there was never a
# shared reference frame for "same sprite X" to mean "same visual
# start" against, no matter how carefully the inputs were matched.
# Pango natively lays out an embedded "\n" as a real multi-line
# paragraph with one alignment mode applied consistently across every
# line in that single layout -- so building the prompt and the stars
# as one two-line string in one Image.Text call, instead of two
# independent calls, is what actually guarantees they share a left
# edge, dynamically, for whatever the real text/font turns out to be --
# not a hardcoded position or size chosen to match this one string.
password_text_sprite = Sprite();
password_text_sprite.SetZ(3);
password_text_sprite.SetOpacity(0);

# Wordmark and track fade in fast (first ~15% of Plymouth's boot-
# duration estimate), then the fill rule tracks real boot progress for
# the rest.
fun spacbr_boot_progress_callback(duration, progress)
{
    fade = progress * 6;
    if (fade > 1)
      {
        fade = 1;
      }
    wordmark_sprite.SetOpacity(fade);
    track_sprite.SetOpacity(fade);
    percent_sprite.SetOpacity(fade);

    fill_width = Math.Int(bar_width * progress);
    if (fill_width > bar_width)
      {
        fill_width = bar_width;
      }
    if (fill_width < 1)
      {
        fill_width = 1;
      }
    fill_image = fill_swatch.Scale(fill_width, bar_height);
    fill_sprite.SetImage(fill_image);

    percent = Math.Int(progress * 100);
    if (percent > 100)
      {
        percent = 100;
      }
    percent_image = Image.Text(percent + "%", 0.882, 0.890, 0.906, 1, "Hack Bold " + bar_label_size);
    percent_sprite.SetImage(percent_image);
    percent_sprite.SetY(track_y + (track_image.GetHeight() - percent_image.GetHeight()) / 2);
}
Plymouth.SetBootProgressFunction(spacbr_boot_progress_callback);

# Rebuilt on every keystroke (Plymouth calls this each time the typed
# count changes, not just once) -- cheap enough (one small Image.Text
# call) that redrawing the whole two-line block from scratch each time
# is simpler and safer than trying to diff against the previous bullet
# count. input_x/input_y themselves never move; only the text drawn at
# that fixed point grows.
fun spacbr_display_password_callback(prompt, bullets)
{
    # Ignore the raw prompt text systemd-ask-password-plymouth actually
    # sends (something like "Please enter passphrase for disk ... to
    # unlock:") -- that string is written for a terminal-based prompt,
    # not this theme, and looks out of place next to everything else
    # here. This theme has exactly one thing that ever asks for a
    # password (the root LUKS2 volume, see docs/architecture.md "Boot &
    # authentication"), so a single fixed, calm label is accurate for
    # every real case, not a guess that happens to fit only this one.
    spacbr_prompt_text = "Enter password to unlock system";

    # Stars, not the filled-circle bullets this used to draw -- asterisk
    # (*) specifically, not a fancier Unicode star (☆/✦/etc.): checked
    # directly against the real Hack-Bold.ttf this theme uses, and none
    # of those exist in it. Rendering a missing glyph is exactly the
    # "unstyled box" look this was meant to move away from, so the
    # plain ASCII asterisk -- guaranteed present, and a real star shape
    # on its own -- is the safe choice, not a fallback compromise.
    stars_text = "";
    for (i = 0; i < bullets; i++)
      {
        stars_text = stars_text + "*  ";
      }

    # One label, two lines (prompt, then stars, joined by a real
    # newline) -- see the note above password_text_sprite for why this
    # is what actually keeps both lines on the same left edge, instead
    # of two separately-measured images that were never guaranteed to
    # share one.
    combined_text = spacbr_prompt_text + "\n" + stars_text;
    combined_image = Image.Text(combined_text, 0.882, 0.890, 0.906, 1, "Hack Bold " + prompt_size);
    password_text_sprite.SetImage(combined_image);
    password_text_sprite.SetX(input_x);
    password_text_sprite.SetY(input_y);
    password_text_sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(spacbr_display_password_callback);

# Called both when a password dialog is dismissed and once at normal
# startup -- hiding an already-hidden sprite is harmless, so no need
# to special-case "was a dialog even showing".
fun spacbr_display_normal_callback()
{
    password_text_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(spacbr_display_normal_callback);

fun spacbr_quit_callback()
{
    wordmark_sprite.SetOpacity(0);
    track_sprite.SetOpacity(0);
    fill_sprite.SetOpacity(0);
    percent_sprite.SetOpacity(0);
    password_text_sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(spacbr_quit_callback);
