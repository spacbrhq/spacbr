# SPACBR — base packages
#
# Core system tooling that isn't specific to the graphical session:
# build toolchain for the Suckless components, shell, and editors.
# One package per line; installed via: pacman -S --needed - < packages/base

base-devel
git
zsh
zsh-syntax-highlighting
# nftables — Arch's native firewall backend (ufw/firewalld are wrappers
# around the same subsystem). Default-deny inbound except SSH/ping; see
# system/nftables/nftables.conf for the actual ruleset and its
# reasoning. Not desktop-specific, so it belongs here, not
# packages/desktop.
nftables
# snapper + snap-pac — btrfs snapshot management with automatic pre/
# post snapshots around every pacman transaction. Real gap this
# machine had: btrfs root, zero recovery path if an update went wrong.
# setup_snapper() (services.sh) skips creating a config if root isn't
# btrfs, so this is harmless to install even on a non-btrfs machine.
snapper
snap-pac
neovim
vim
# Language servers for nvim/init.lua's native vim.lsp config -- not
# generic dev-workstation tooling, these back a real, wired-up feature
# of SPACBR's own editor config. clang (clangd) was previously excluded
# below as exactly that kind of generic tooling; that reasoning no
# longer applies now that clangd is a hard dependency of a real SPACBR
# feature, not a maybe-someone-wants-it addition. Matches this repo's
# own languages: C (dwm/dmenu/st/slock/dwmblocks source), Lua (this
# nvim config), sh (install/*.sh, .local/bin/*).
clang
lua-language-server
bash-language-server
htop
fontconfig
freetype2
ttf-hack
# Hack has no emoji/wide-Unicode glyphs — Noto fills that gap for
# browsers/documents without pulling in the much larger CJK set.
noto-fonts
noto-fonts-emoji

# Fetch/sync/transfer — curl is already assumed by
# .config/firefox/firefox.sh; wget and rsync are the other two
# fundamentals of the same kind.
curl
wget
rsync

# SSH client — near-universal for git/remote work.
openssh

# Needed only to install the Claude Code CLI (npm, not a pacman
# package -- see install_claude_code() in packages.sh).
nodejs
npm

# git-delta -- syntax-highlighted diff pager, wired in as core.pager
# in .config/git/config. restic -- off-site backup; snapper protects
# against a bad update on the same disk, not disk failure or theft,
# which nothing else here covers.
git-delta
restic

# Shell quality-of-life: small, single-purpose, official, no daemons.
# From your previous install's explicit list, not transitive noise.
ripgrep
fd
bat
fzf
zoxide
jq
tree
tmux
nnn
fastfetch

# Local network file transfer and cross-device sync -- real,
# expressed needs, not speculative. Neither is desktop-specific (both
# work headless), so base rather than packages/desktop.
tailscale
syncthing

# Mirror-list maintenance for pacman itself.
reflector
pacman-contrib

# go: kept because ~/.config/shell/profile already exports
# GOPATH/GOMODCACHE — this is the one language toolchain with actual
# evidence of use in this repo. Everything else in your previous
# list's dev-toolchain tail (node/npm/pnpm/deno/rust/python extras/
# cmake/meson/ninja/valgrind/gdb) is still left out on purpose: it's a
# general-purpose dev workstation's package set, not SPACBR's desktop-
# system scope. Keep those in your own separate list if you want them
# — don't fold them into this manifest. (clang moved up next to
# neovim/vim: it's no longer in this "left out" category now that
# clangd backs a real nvim LSP feature.)
go
