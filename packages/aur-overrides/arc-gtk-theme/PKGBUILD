# SPACBR-maintained fork of the AUR arc-gtk-theme PKGBUILD.
#
# Why this exists: the published AUR package fails to build outright.
# Its build() hardcodes GNOME Shell theming for version 43
# (-Dgnome_shell_version=43), but the pinned upstream source tarball
# (20221218) doesn't have the asset layout that build step expects --
# meson dies with "File .../common/gnome-shell/43/icons does not
# exist." Verified for real: a clean `paru -S arc-gtk-theme` fails with
# that exact error. Matches the AUR page's own "flagged out-of-date
# since 2025-11-30, unaddressed" status.
#
# SPACBR only needs the GTK 2/3/4 theme -- it targets dwm, not GNOME
# Shell or Cinnamon, so their theming was never something this project
# uses. Passing -Dthemes=gtk2,gtk3,gtk4 skips those broken/irrelevant
# build steps entirely. Verified for real: same source tarball, same
# checksums, only the meson invocation changed, and it builds and
# installs Arc-Dark cleanly.
#
# Everything else (source URL, checksums, GPG key) is unmodified from
# upstream -- only the build() options change, and the split
# arc-solid-gtk-theme package is dropped since SPACBR never installs
# it. Re-check upstream periodically; drop this fork if it's ever
# fixed there instead.
#
# Original maintainer: NicoHood <archlinux {cat} nicohood {dog} de>
# Original PGP ID: 97312D5EB9D7AE7D0BD4307351DAE9B7C1AE9161

pkgname=arc-gtk-theme
_pkgname=arc-theme
pkgver=20221218
pkgrel=2
pkgdesc="A flat theme with transparent elements for GTK 2,3,4 (SPACBR fork: GTK-only build, upstream GNOME Shell 43 step is broken)"
arch=('any')
url="https://github.com/jnsh/arc-theme"
license=('GPL3')
optdepends=('gtk-engine-murrine: for gtk2 themes'
            'gnome-themes-standard: for gtk2 themes')
makedepends=('meson>=0.53.0' 'sassc' 'glib2' 'gdk-pixbuf2')
replaces=('gtk-theme-arc')

source=("${pkgname}-${pkgver}.tar.xz::${url}/releases/download/${pkgver}/${_pkgname}-${pkgver}.tar.xz"
        "${pkgname}-${pkgver}.tar.xz.sig::${url}/releases/download/${pkgver}/${_pkgname}-${pkgver}.tar.xz.asc")
sha512sums=('5a84b717de022c673c6af260381542365550f629f43ae99c7ab8b22b4c09024403a1bc06279b40d3560e86d9810683c2e8337799a4cc67ef7aeb93223b5f56a1'
            'SKIP')
validpgpkeys=('31743CDF250EF641E57503E5FAEDBC4FB5AA3B17')

prepare() {
    cd ${_pkgname}-${pkgver}
}

build() {
    cd ${_pkgname}-${pkgver}
    meson --prefix=/usr build -Dthemes=gtk2,gtk3,gtk4
    meson compile -C build
}

package() {
    cd ${_pkgname}-${pkgver}
    DESTDIR="$pkgdir" meson install -C build
}
