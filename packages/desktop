# SPACBR — desktop capabilities
#
# Everything that backs a spacbr dmenu/CLI capability (§21-30 of
# CLAUDE.md) plus the applications the existing config already assumes:
# networking, audio, bluetooth, file management, documents, media,
# browser, and the screenshot/clipboard/passmenu toolchain.
# One package per line; installed via: pacman -S --needed - < packages/desktop

networkmanager
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
bluez
bluez-utils
playerctl
pcmanfm
libfm
gvfs
udisks2
zathura
zathura-pdf-mupdf
mpv
# mpd + rmpc — a real, separate need from mpv/playerctl: a persistent
# music library/queue (survives closing the client, controllable from
# multiple terminals) rather than "play this one file/stream". Runs as
# the user-level mpd.socket/mpd.service (see .config/mpd/mpd.conf and
# setup_mpd() in services.sh) -- not the system-wide mpd user the
# package also ships, which would need permission setup to read
# ~/Music for no benefit on a single-user desktop.
mpd
rmpc
# nsxiv — Images had no owner (§7 names Documents/Media/Browser but
# nothing for image/*), and handlr-regex was correctly routing
# audio/video/pdf but had nowhere to send images. Suckless-lineage
# (fork of sxiv), X11-native, official (extra) — the same fit as
# dwm/dmenu/st/slock without needing to join them as a built-from-
# source component (no compelling reason to patch it).
nsxiv
# zed — a deliberate, documented exception to Neovim/Vim owning
# "Editor" (CLAUDE.md §7): specifically for GUI/mouse-driven work,
# nvim stays the terminal/keyboard-driven editor. Official (extra).
zed
yt-dlp
firefox
xclip
libnotify
imagemagick
xdotool
slop
pass
pass-otp
gnupg
qrencode
# GTK theming: Arc-Dark (theme) + Papirus-Dark (icons) + Adwaita
# (cursors) are what gtk-2.0/3.0/4.0 and xinitrc's GTK_THEME already
# assume — all three package names below are real gaps the original
# manifest missed, not new additions from the pkg dump.
# papirus-icon-theme is official (extra); the Arc-Dark GTK theme
# itself is AUR-only — see packages/aur.
papirus-icon-theme
hicolor-icon-theme
adwaita-cursors
# gtk2 runtime — this repo tracks .config/gtk-2.0/gtkrc; without a
# GTK2-compatible runtime that config has nothing to apply to. Actual
# GTK2 was removed from the official Arch repos entirely (confirmed
# live against pacman) -- gtk2-compat ("simulates the presence of
# GTK+2, but tries to use GTK+3") is the current replacement.
gtk2-compat
# ffmpeg — .config/shell/aliasrc already aliases it
# ("ffmpeg -hide_banner"); ffmpegthumbnailer backs pcmanfm's icon-view
# thumbnails (view_mode=icon in pcmanfm.conf).
ffmpeg
ffmpegthumbnailer
# Archive management — pcmanfm's right-click extract needs a handler;
# nothing filled this gap before.
file-roller
unzip
zip
7zip
# polkit — NetworkManager and udisks2 (pcmanfm's automount) both use
# it for privileged actions. polkit-gnome is the actual agent (official,
# extra, despite being labeled "legacy" — it's still the standard
# choice for minimal WMs without a full desktop environment); both
# are now started from xinitrc.
polkit
polkit-gnome
speedtest-cli
handlr-regex
# clipmenu — dmenu-driven clipboard history. Turned out to be an
# official package (extra), not AUR like your previous list's
# "clipmenu-git" assumed. §28 of CLAUDE.md names exactly this as
# acceptable ("clipboard history through dmenu only if useful").
# clipmenud is started from xinitrc; MODKEY+c opens the picker.
clipmenu
# gpg-agent.conf points at /usr/bin/pinentry-gnome3. The package named
# "pinentry-gnome3" was removed from the Arch repos entirely (confirmed
# live against pacman) -- Arch consolidated every pinentry frontend
# (curses/emacs/gnome3/gtk/qt/tty) into one "pinentry" package that
# ships all the binaries, including pinentry-gnome3 itself, so the
# gpg-agent.conf path still works unchanged with just this one package.
pinentry
# alacritty -- st stays the primary terminal (§7's one-owner rule:
# $TERMINAL, MODKEY+T, everywhere else in this repo). This is an
# available alternative (.config/alacritty/alacritty.toml, themed to
# match), not a second owner -- not wired into xinitrc/dwm defaults.
alacritty
